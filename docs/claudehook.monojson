    },
    {
      "doc_ref" : "6040FD87-97F9-4B8A-B56D-D6450FCD6EB6",
      "object_id" : "241E74FF-1400-4455-9BF2-2676CE9AA58F",
      "text" : "A4",
      "type_id" : 27
    },
    {
      "doc_ref" : "6040FD87-97F9-4B8A-B56D-D6450FCD6EB6",
      "object_id" : "243E7906-2B1D-4470-88CC-35378628EBF2",
      "rect_position" : 15,
